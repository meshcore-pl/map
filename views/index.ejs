<!DOCTYPE html>
<html lang="pl">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Mapa węzłów MeshCore Polska</title>

	<!-- Primary meta -->
	<meta name="description" content="Interaktywna mapa węzłów sieci MeshCore w Polsce i na świecie. Klienci, repeatery, serwery pokoju oraz czujniki na żywo.">
	<meta name="keywords" content="meshcore, mapa meshcore, meshcore polska, mesh, lora, węzły meshcore, repeater meshcore">
	<link rel="canonical" href="<%= domain %>/">
	<meta name="theme-color" content="#95010b">

	<!-- Open Graph -->
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="MeshCore Polska">
	<meta property="og:locale" content="pl_PL">
	<meta property="og:title" content="Mapa węzłów MeshCore Polska">
	<meta property="og:description" content="Interaktywna mapa węzłów sieci MeshCore w Polsce i na świecie.">
	<meta property="og:url" content="<%= domain %>/">
	<meta property="og:image" content="https://meshcorepolska.org/images/brand/banner-og.jpg">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="675">
	<meta property="og:image:alt" content="MeshCore Polska: ogólnopolska społeczność sieci mesh">

	<!-- Twitter / X Card -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="Mapa węzłów MeshCore Polska">
	<meta name="twitter:description" content="Interaktywna mapa węzłów sieci MeshCore w Polsce i na świecie.">
	<meta name="twitter:image" content="https://meshcorepolska.org/images/brand/banner-og.jpg">
	<meta name="twitter:image:alt" content="MeshCore Polska: ogólnopolska społeczność sieci mesh">

	<!-- JavaScript -->
	<script src="https://cdn.sefinek.net/js/progressbar.js" defer></script>

	<!-- Icons & manifest -->
	<link rel="icon" href="https://meshcorepolska.org/favicon.ico" sizes="16x16 32x32 48x48 64x64 128x128 256x256">
	<link rel="icon" href="https://meshcorepolska.org/images/brand/logo-3-192.png" type="image/png" sizes="192x192">
	<link rel="apple-touch-icon" href="https://meshcorepolska.org/images/brand/logo-3-180.png" sizes="180x180">
	<link rel="manifest" href="/manifest.json">

	<!-- Stylesheets -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,800&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
	<link rel="stylesheet" href="/vendor/markercluster/MarkerCluster.css">
	<link rel="stylesheet" href="/vendor/markercluster/MarkerCluster.Default.css">
	<link rel="stylesheet" href="/css/global.css">
	<link rel="stylesheet" href="/css/legend.css">
	<link rel="stylesheet" href="/css/modal.css">
	<link rel="stylesheet" href="/css/stats.css">
	<link rel="stylesheet" href="/css/toast.css">
	<link rel="stylesheet" href="/css/tools.css">

	<!-- schema.org -->
	<script type="application/ld+json">
	<%- JSON.stringify({
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'Organization',
				'@id': 'https://meshcorepolska.org/#organization',
				name: 'MeshCore Polska',
				url: 'https://meshcorepolska.org/',
				sameAs: ['https://github.com/meshcore-pl', 'https://meshcorepolska.org/discord'],
			},
			{
				'@type': 'WebApplication',
				'@id': `${domain}/#webapp`,
				name: 'Mapa MeshCore Polska',
				description: 'Interaktywna mapa węzłów sieci MeshCore w Polsce i na świecie.',
				url: `${domain}/`,
				applicationCategory: 'UtilitiesApplication',
				operatingSystem: 'Any',
				isPartOf: { '@id': 'https://meshcorepolska.org/#organization' },
			},
			{
				'@type': 'WebSite',
				'@id': `${domain}/#website`,
				name: 'Mapa MeshCore Polska',
				url: `${domain}/`,
				inLanguage: 'pl-PL',
				publisher: { '@id': 'https://meshcorepolska.org/#organization' },
			},
			{
				'@type': 'BreadcrumbList',
				itemListElement: [
					{ '@type': 'ListItem', position: 1, name: 'Mapa MeshCore Polska', item: `${domain}/` },
				],
			},
		],
	}) %>
	</script>
</head>
<body>
<main id="map"></main>
<div id="loading-overlay" role="status" aria-live="polite" aria-label="Ładowanie węzłów" hidden>
	<div id="loading-card">
		<div id="spinner"></div>
		<div id="loading-status"></div>
		<div id="loading-progress"><div id="loading-progress-bar"></div></div>
		<div id="loading-meta"></div>
		<button type="button" id="loading-cancel-btn">Anuluj</button>
	</div>
</div>

<header id="stats-bar">
	<a id="brand" href="https://meshcorepolska.org/" target="_blank" rel="noopener" title="MeshCore Polska">
		<img src="https://meshcorepolska.org/images/brand/logo-1-80.jpg" alt="" width="34" height="34">
		<span id="brand-name">MeshCore <strong>Polska</strong></span>
	</a>
	<span id="stats-divider"></span>
	<span id="stats-counts"></span>
	<button type="button" class="region-toggle-btn" id="stats-toggle" title="Nowe węzły i repeatery" aria-label="Nowe węzły i repeatery">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#chart"></use></svg>
	</button>

	<span class="spacer" id="spacer-1"></span>
	<form id="search-form">
		<svg class="icon" id="search-icon" aria-hidden="true"><use href="/icons/icons.svg#search"></use></svg>
		<input type="text" class="text-input" id="search-input" placeholder="Szukaj węzłów..." autocomplete="off">
		<button type="button" id="filter-toggle" title="Przełącz filtry" aria-label="Przełącz filtry">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#filter"></use></svg>
			<span id="filter-active-dot" hidden></span>
		</button>
	</form>

	<span class="spacer" id="spacer-2"></span>
	<button type="button" class="region-toggle-btn" id="region-toggle" title="Pokaż wszystkie węzły na świecie" aria-label="Pokaż wszystkie węzły na świecie">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#globe"></use></svg>
		<span id="region-toggle-label">Tylko Polska</span>
	</button>
	<button type="button" class="region-toggle-btn" id="basemap-toggle" title="Przełącz warstwę mapy" aria-label="Przełącz warstwę mapy">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#layers"></use></svg>
		<span id="basemap-toggle-label">Zmień mapę</span>
	</button>
	<a href="https://github.com/meshcore-pl/map" id="github-link" title="Przejdź do repozytorium GitHub" aria-label="Przejdź do repozytorium GitHub" target="_blank" rel="noopener">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#github"></use></svg>
	</a>
</header>

<menu id="node-filter" hidden>
	<li id="filters-row">
		<div class="filters-col" id="filters-col-main">
			<fieldset id="node-type-group">
				<legend>Typy węzłów</legend>
				<label class="checkbox-label"><input type="checkbox" class="node-type-checkbox" value="1" checked> Klienci</label>
				<label class="checkbox-label"><input type="checkbox" class="node-type-checkbox" value="2" checked> Repeatery</label>
				<label class="checkbox-label"><input type="checkbox" class="node-type-checkbox" value="3" checked> Serwery pokoju</label>
				<label class="checkbox-label"><input type="checkbox" class="node-type-checkbox" value="4" checked> Czujniki</label>
			</fieldset>
			<div class="field-group">
				<label for="from-date">Ostatnia aktualizacja</label>
				<input type="date" class="date-input" id="from-date">
			</div>
			<div class="field-group">
				<label for="from-insert-date">Dodano</label>
				<input type="date" class="date-input" id="from-insert-date">
			</div>
			<div class="field-group">
				<label for="clustering-zoom">Poziom powiększenia grupowania</label>
				<input type="range" id="clustering-zoom" min="10" max="17" value="11">
			</div>
		</div>
		<div class="filters-col field-group" id="freq-filter-group" hidden>
			<span>Częstotliwość</span>
			<div id="freq-filter-list"></div>
		</div>
	</li>
	<li class="filters-actions">
		<button type="button" class="apply-filters-btn" id="apply-filters-btn">Zastosuj filtry</button>
		<button type="button" class="clear-filters-btn" id="clear-filters-btn" hidden>Wyczyść filtry</button>
	</li>
</menu>

<ul id="search-results" hidden></ul>

<ul id="basemap-menu" hidden></ul>

<div id="fab-stack">
	<button type="button" class="fab fab-secondary" id="terrain-toggle" title="Analiza terenu i zasięgu" aria-label="Analiza terenu i zasięgu">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#terrain"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="route-toggle" title="Trasa po nazwach lub hashach" aria-label="Trasa po nazwach lub hashach">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#route"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="measure-toggle" title="Mierz odległość" aria-label="Mierz odległość">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#ruler"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="settings-toggle" title="Ustawienia" aria-label="Ustawienia">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#settings"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="legend-toggle" title="Legenda mapy" aria-label="Legenda mapy">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#info"></use></svg>
	</button>
	<a class="fab" id="fab-primary" title="Dodaj węzeł do mapy" aria-label="Dodaj węzeł do mapy" target="_blank" rel="noopener" href="https://github.com/meshcore-dev/MeshCore/blob/main/docs/faq.md#512-q-how-do-i-add-a-node-to-the-meshcore-map">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#plus"></use></svg>
	</a>
</div>

<div class="modal-overlay" id="region-warning-overlay" hidden>
	<div class="settings-panel" id="region-warning-panel" role="dialog" aria-modal="true" aria-labelledby="region-warning-title">
		<div id="region-warning-header">
			<span id="region-warning-icon"><svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#warning"></use></svg></span>
			<div class="modal-title" id="region-warning-title">Jesteś tego pewny?</div>
		</div>
		<p id="region-warning-text">
			Dane obejmujące cały świat ważą <span id="region-warning-size">nieznany rozmiar</span>, to znacznie więcej niż same węzły z Polski.
			Jeśli posiadasz limitowany pakiet internetu u operatora, pobranie tylu danych może minimalnie go nadgryźć.
			Na starszych urządzeniach mapa może stać się też trochę mniej responsywna.
		</p>
		<div id="region-warning-actions">
			<button type="button" class="region-warning-btn" id="region-warning-cancel">Anuluj</button>
			<button type="button" class="region-warning-btn" id="region-warning-confirm">Pobierz mimo to</button>
		</div>
	</div>
</div>

<div class="modal-overlay" id="settings-overlay" hidden>
	<div class="settings-panel" id="settings-panel" role="dialog" aria-modal="true" aria-labelledby="settings-title">
		<button type="button" class="modal-close-btn" id="settings-close-btn" aria-label="Zamknij ustawienia">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<div class="modal-title" id="settings-title">Ustawienia</div>

		<div class="setting-item">
			<label class="checkbox-label"><input type="checkbox" id="setting-close-filters-on-apply" checked aria-describedby="setting-close-filters-desc"> Zamykaj okno filtrów po zastosowaniu</label>
			<p class="setting-desc" id="setting-close-filters-desc">Po kliknięciu „Zastosuj filtry” panel filtrów zamknie się automatycznie zamiast pozostać otwarty.</p>
		</div>

		<div class="setting-item" id="setting-item-select">
			<label for="setting-elevation-source" id="setting-label">Źródło danych wysokościowych (analiza terenu)</label>
			<select class="date-input" id="setting-elevation-source" aria-describedby="setting-elevation-desc">
				<option value="sefinek" selected>Sefinek API - beta (self-hosted)</option>
				<option value="open-elevation">Open-Elevation (publiczne)</option>
				<option value="open-meteo">Open-Meteo (publiczne)</option>
			</select>
			<p class="setting-desc" id="setting-elevation-desc">Używane przez narzędzie „Analiza terenu i zasięgu”. Zmień, jeśli faktycznie masz taką potrzebę.</p>
		</div>

		<div class="modal-title" id="settings-subtitle">Zaawansowane</div>

		<div class="setting-item">
			<label class="checkbox-label"><input type="checkbox" id="setting-show-openfreemap" aria-describedby="setting-openfreemap-desc"> Pokaż OpenFreeMap w przełączniku map</label>
			<p class="setting-desc" id="setting-openfreemap-desc">Jest to darmowa mapa wektorowa oparta na danych OpenStreetMap. W odróżnieniu od pozostałych map (zwykłe obrazki, kafelki) wymaga dociągnięcia dodatkowej biblioteki renderującej w przeglądarce (~1&nbsp;MB), dlatego jest domyślnie wyłączona. Włącz ją tylko, jeśli faktycznie chcesz z niej skorzystać.</p>
		</div>
	</div>
</div>

<div class="modal-overlay" id="stats-overlay" hidden>
	<div id="stats-panel" role="dialog" aria-modal="true" aria-labelledby="stats-title">
		<button type="button" class="modal-close-btn" id="stats-close-btn" aria-label="Zamknij statystyki">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<div class="modal-title" id="stats-title">Nowe węzły</div>
		<div id="stats-chips">
			<div class="stats-chip"><span class="stats-chip-label">24h</span><span class="stats-chip-value" id="stats-chip-24h">0</span></div>
			<div class="stats-chip"><span class="stats-chip-label">7d</span><span class="stats-chip-value" id="stats-chip-7d">0</span></div>
			<div class="stats-chip"><span class="stats-chip-label">30d</span><span class="stats-chip-value" id="stats-chip-30d">0</span></div>
		</div>
		<div id="stats-period-group" role="group" aria-label="Zakres czasu">
			<button type="button" class="stats-period-btn active" data-period="24h">24h</button>
			<button type="button" class="stats-period-btn" data-period="7d">7d</button>
			<button type="button" class="stats-period-btn" data-period="30d">30d</button>
			<button type="button" class="stats-period-btn" data-period="custom">Zakres</button>
		</div>
		<div id="stats-range-inputs" hidden>
			<input type="date" class="date-input" id="stats-range-from" aria-label="Od daty">
			<span id="stats-range-sep">–</span>
			<input type="date" class="date-input" id="stats-range-to" aria-label="Do daty">
			<button type="button" id="stats-range-back-btn" aria-label="Wróć do zakresów">
				<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
			</button>
		</div>
		<ul id="stats-repeater-list"></ul>
		<button type="button" class="btn btn-outline" id="stats-show-on-map-btn">Pokaż na mapie</button>
	</div>
</div>

<div class="modal-overlay" id="legend-overlay" hidden>
	<div class="settings-panel" id="legend-panel" role="dialog" aria-modal="true" aria-labelledby="legend-title">
		<button type="button" class="modal-close-btn" id="legend-close-btn" aria-label="Zamknij legendę">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<section id="legend-plans" aria-labelledby="legend-plans-title">
			<div class="modal-title" id="legend-plans-title">Co dalej?</div>
			<p>Planowany jest serwis <a href="https://meshcoreprofiles.com" target="_blank" rel="noopener">meshcoreprofiles.com</a>, zintegrowany z mapą węzłów z całego świata.</p>
			<ul>
				<li>Użytkownicy, którzy wprowadzą dane o companionie lub RPT, otrzymają własny profil.</li>
				<li>Wybrane informacje z profili będą widoczne bezpośrednio na mapie, dzięki czemu będzie można łatwo sprawdzić, do kogo należy dany węzeł.</li>
				<li>Właściciele repeaterów będą mogli przesyłać ich zdjęcia, które następnie zostaną publicznie wyświetlone w serwisie.</li>
			</ul>
			<p>Testowa wersja konfiguratora jest obecnie dostępna wyłącznie dla użytkowników serwera <a href="https://meshcorepolska.org/discord" target="_blank" rel="noopener">Discord MeshCore Polska</a> (komenda <code>/konfigurator</code> od <code>Sefi#6347</code>). <a href="https://beta.sefinek.net/meshcore-pl/kontakty/6a43efd454feb8be5679e0a6" target="_blank" rel="noopener">Zobacz przykładowy</a>.</p>
		</section>

		<div id="legend-columns">
			<div class="legend-col">
				<div class="modal-title" id="legend-title">Rodzaj</div>
				<div class="legend-row"><svg class="legend-icon legend-icon-plain" width="20" height="20"><use href="/icons/node-types.svg#client-plain"></use></svg><span>Klient</span></div>
				<div class="legend-row"><svg class="legend-icon legend-icon-plain" width="20" height="20"><use href="/icons/node-types.svg#repeater-plain"></use></svg><span>Repeater</span></div>
				<div class="legend-row"><svg class="legend-icon legend-icon-plain" width="20" height="20"><use href="/icons/node-types.svg#room-server-plain"></use></svg><span>Serwer pokoju</span></div>
				<div class="legend-row"><svg class="legend-icon legend-icon-plain" width="20" height="20"><use href="/icons/node-types.svg#sensor-plain"></use></svg><span>Czujnik</span></div>
			</div>

			<div class="legend-col">
				<div class="modal-title">Mapa</div>
				<div class="legend-row"><svg class="legend-icon update-recent" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span>Zaktualizowano niedawno</span></div>
				<div class="legend-row"><svg class="legend-icon update-stale" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span>Zaktualizowano jakiś czas temu</span></div>
				<div class="legend-row"><svg class="legend-icon update-old" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span>Dawno nieaktualizowany</span></div>
				<div class="legend-row"><svg class="legend-icon update-extinct" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span>Zostanie wkrótce usunięty</span></div>
				<div class="legend-row"><svg class="legend-icon" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span>Dodano ręcznie</span></div>
			</div>
		</div>

		<div id="legend-footer">
			<div id="legend-footer-meta">
				<div>Wersja witryny: v<%= v %></div>
				<div>Aktualizacja danych: <span id="legend-updated-at">-</span></div>
			</div>
			<button type="button" class="btn btn-outline" id="changelog-toggle">Lista zmian</button>
		</div>
	</div>
</div>

<div class="modal-overlay" id="changelog-overlay" hidden>
	<div class="settings-panel" id="changelog-panel" role="dialog" aria-modal="true" aria-label="Lista zmian">
		<button type="button" class="modal-close-btn" id="changelog-close-btn" aria-label="Zamknij listę zmian">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<ul id="changelog-list"></ul>
	</div>
</div>

<div class="modal-overlay" id="node-overlay" hidden>
	<div class="settings-panel" id="node-panel" role="dialog" aria-modal="true" aria-label="Szczegóły węzła">
		<button type="button" class="modal-close-btn" id="node-modal-close" aria-label="Zamknij okno węzła">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<div id="node-panel-content"></div>
	</div>
</div>

<div id="measure-panel" hidden>
	<div id="tool-panel-header">
		<span class="modal-title">Mierzenie odległości (beta)</span>
		<span class="tool-panel-total" id="measure-total">0 m</span>
		<button type="button" class="modal-close-btn" id="measure-close-btn" aria-label="Zamknij narzędzie pomiaru">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
	</div>
	<p id="tool-panel-hint">Kliknij mapę lub na węzeł, aby dokonać pomiaru odległości.</p>
	<ul class="tool-panel-list" id="measure-list"></ul>
	<div class="filters-actions">
		<button type="button" class="btn btn-outline" id="measure-share-btn">Udostępnij</button>
		<button type="button" class="btn btn-outline" id="measure-label-mode-btn">Nazwy</button>
		<button type="button" class="btn btn-outline" id="measure-undo-btn">Cofnij punkt</button>
		<button type="button" class="clear-filters-btn" id="measure-clear-btn">Wyczyść</button>
	</div>
</div>

<div class="modal-overlay" id="route-overlay" hidden>
	<div class="settings-panel" id="route-panel" role="dialog" aria-modal="true" aria-labelledby="route-title">
		<button type="button" class="modal-close-btn" id="route-close-btn" aria-label="Zamknij okno trasy">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<div class="modal-title" id="route-title">Trasa po nazwach lub hashach (beta)</div>
		<p class="setting-desc tool-modal-desc">Wpisz nazwy repeaterów, początki ich kluczy publicznych (pierwsze 2, 4 lub 6 znaków) albo całe klucze - w kolejności zgodnej z trasą. Poszczególne wartości oddzielaj przecinkami, znakiem ">" lub nowymi wierszami.</p>
		<textarea id="route-input" rows="3" placeholder="np. Piła_Wodna_Rpt &gt; 3dae &gt; bf83e1"></textarea>
		<div class="filters-actions" id="route-actions">
			<button type="button" class="apply-filters-btn" id="route-draw-btn">Narysuj trasę</button>
			<button type="button" class="clear-filters-btn" id="route-clear-btn">Wyczyść</button>
		</div>
		<div class="tool-panel-total" id="route-total" hidden></div>
		<ul class="tool-panel-list" id="route-result-list"></ul>
	</div>
</div>

<div class="modal-overlay" id="terrain-overlay" hidden>
	<div class="settings-panel" id="terrain-panel" role="dialog" aria-modal="true" aria-labelledby="terrain-title">
		<button type="button" class="modal-close-btn" id="terrain-close-btn" aria-label="Zamknij analizę terenu">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<div class="modal-title" id="terrain-title">Analiza terenu i zasięgu (beta)</div>
		<p class="setting-desc tool-modal-desc">Wybierz dwa punkty (kliknij węzeł na mapie lub wpisz nazwę), aby zobaczyć profil terenu i orientacyjną widoczność optyczną między nimi. Źródło danych wysokościowych możesz zmienić w Ustawieniach.</p>

		<div id="terrain-point-row">
			<div class="terrain-point" data-point="a">
				<span class="terrain-point-label" id="terrain-point-label-a">A</span>
				<input type="text" class="text-input terrain-point-input" id="terrain-point-a-input" placeholder="Nazwa węzła" autocomplete="off">
				<button type="button" class="btn btn-outline terrain-pick-btn" id="terrain-pick-a-btn" data-point="a">Wskaż na mapie</button>
			</div>
			<div class="terrain-point" data-point="b">
				<span class="terrain-point-label" id="terrain-point-label-b">B</span>
				<input type="text" class="text-input terrain-point-input" id="terrain-point-b-input" placeholder="Nazwa węzła" autocomplete="off">
				<button type="button" class="btn btn-outline terrain-pick-btn" id="terrain-pick-b-btn" data-point="b">Wskaż na mapie</button>
			</div>
		</div>

		<div id="terrain-height-row">
			<label class="field-group terrain-height-field">
				<span>Wysokość anteny A (m)</span>
				<input type="number" class="text-input" id="terrain-height-a" value="5" min="0" max="200" step="0.5">
			</label>
			<label class="field-group terrain-height-field">
				<span>Wysokość anteny B (m)</span>
				<input type="number" class="text-input" id="terrain-height-b" value="5" min="0" max="200" step="0.5">
			</label>
		</div>

		<div class="filters-actions">
			<button type="button" class="apply-filters-btn" id="terrain-analyze-btn">Analizuj</button>
			<button type="button" class="btn btn-outline" id="terrain-share-btn">Udostępnij</button>
			<button type="button" class="clear-filters-btn" id="terrain-clear-btn">Wyczyść</button>
		</div>

		<div id="terrain-result" hidden></div>
	</div>
</div>

<div id="toast-container" aria-live="polite"></div>

<script>window.MAP_CONFIG = { sefinekApi: <%- JSON.stringify(sefinekApi) %> };</script>
<script src="/vendor/leaflet/leaflet.js"></script>
<script src="/vendor/markercluster/leaflet.markercluster.js"></script>
<script src="/js/map.js" type="module"></script>
</body>
</html>
